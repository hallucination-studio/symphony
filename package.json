{
  "name": "symphony",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.21.0 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/conductor"
  ],
  "scripts": {
    "build": "npm run build -w @symphony/conductor",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run lint:e2e",
    "lint:e2e": "eslint tests/e2e --ext .mjs --max-warnings 0",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "test:e2e": "node tests/e2e/e2e-supervisor.mjs",
    "test:e2e:runner": "node --test tests/e2e/black-box-runner.test.mjs tests/e2e/deterministic-scenarios.test.mjs tests/e2e/real-boundary-runners.test.mjs tests/e2e/golden-runner.test.mjs tests/e2e/e2e-supervisor.test.mjs",
    "test:typescript": "npm test -w @symphony/conductor",
    "test": "npm run test:architecture && npm run test:typescript && npm run test:e2e:runner"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "eslint": "8.57.1",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.1",
    "tsx": "4.23.1",
    "typescript": "5.6.3"
  }
}
